<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/logo_circle"
            android:elevation="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Escola App"
            android:textColor="@color/white"
            android:textSize="38sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="36dp"
            android:alpha="0.85"
            android:gravity="center"
            android:text="Disciplinas, alunos, notas e matrículas"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnDisciplinas"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_btn_disciplinas"
            android:elevation="6dp"
            android:gravity="start|center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@animator/btn_press"
            android:text="📚   Disciplinas"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAlunos"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_btn_alunos"
            android:elevation="6dp"
            android:gravity="start|center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@animator/btn_press"
            android:text="🎓   Alunos"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNotas"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_btn_notas"
            android:elevation="6dp"
            android:gravity="start|center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@animator/btn_press"
            android:text="📝   Notas do aluno"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMatriculas"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_btn_matriculas"
            android:elevation="6dp"
            android:gravity="start|center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="16dp"
            android:stateListAnimator="@animator/btn_press"
            android:text="📋   Matrículas do aluno"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
